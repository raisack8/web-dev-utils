# パスキー認証
# セッションCookieの署名用(32文字以上)。`openssl rand -base64 32` で生成
SESSION_SECRET=""
# パスキーを紐づけるドメイン(本番: example.com / 開発: localhost)。変更すると登録済みパスキーが無効になる
WEBAUTHN_RP_ID=""
# ログイン画面のオリジン(本番: https://example.com / 開発: http://localhost:3000)
WEBAUTHN_ORIGIN=""
# パスキー初回登録用の合言葉。登録後は削除か変更する
SETUP_TOKEN=""
# 複数プロジェクトで共有しているUpstash Redis。
# キーの衝突防止は src/lib/redis/client.ts の REDIS_NAMESPACE で自動的に行われる
REDIS_URL=""
# Vercel Blob（ファイル保存用）
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

